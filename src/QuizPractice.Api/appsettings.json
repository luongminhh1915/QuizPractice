{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Account mails (UC-02 to UC-04). With Host empty no mail leaves the machine: each
  // one is an .eml file in App_Data/mails. Put a real SMTP server, user name and
  // password in appsettings.Development.json, never here.
  "Email": {
    "From": "no-reply@qps.vn",
    "FromName": "QuizPractice",
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "LinkBaseUrl": "http://localhost:5173"
  },

  // How long a mailed link works (BR-01, BR-02).
  "Links": {
    "VerifyEmailHours": 24,
    "ResetPasswordMinutes": 30
  },

  // Permission table (F#4, BR-03, D23): which roles may open each System Menu item.
  // The API guards its controllers with it and the menu of a role shows only these
  // items. Changing it needs a restart.
  "Permissions": {
    "Dashboard": [ "Marketing", "Sale", "Admin" ],
    "Posts": [ "Marketing" ],
    "Sliders": [ "Marketing" ],
    "Registrations": [ "Sale" ],
    "Invoices": [ "Sale" ],
    "Subjects": [ "Admin", "Expert" ],
    "Questions": [ "Admin", "Expert" ],
    "Quizzes": [ "Admin", "Expert" ],
    "Users": [ "Admin" ],
    "Settings": [ "Admin" ],
    "My Registrations": [ "Customer" ],
    "Practices": [ "Customer" ],
    "Simulation Exams": [ "Customer" ],
    "My Invoices": [ "Customer" ]
  }
}
